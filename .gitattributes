# Auto detect text files and perform LF normalization
* text=auto

# Scripts & Source code
*.sh text eol=lf
*.c text eol=lf
*.h text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Makefile text eol=lf

# Binary files
*.ko binary
*.o binary
*.pdf binary
*.png binary
*.jpg binary
