From: Exequiel Echevarria <exemetal@hotmail.com>
Subject: [PATCH 2/4] osdep: adapt cfg80211 key operations to struct wireless_dev for Linux 7.1+

In Linux kernel 7.1, cfg80211_ops callback functions for key management
(add_key, del_key, get_key, set_default_key, set_default_mgmt_key)
receive `struct wireless_dev *wdev` instead of `struct net_device *ndev`.
Adapt parameters and retrieve `ndev = wdev->netdev`.

---
 os_dep/linux/ioctl_cfg80211.c | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/os_dep/linux/ioctl_cfg80211.c b/os_dep/linux/ioctl_cfg80211.c
index f30ab12..c914e78 100644
--- a/os_dep/linux/ioctl_cfg80211.c
+++ b/os_dep/linux/ioctl_cfg80211.c
@@ -1674,7 +1674,11 @@ static int cfg80211_rtw_add_key(struct wiphy *wiphy,
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0)
+        struct wireless_dev *wdev
+#else
+        struct net_device *ndev
+#endif
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0))
         , int link_id
 #endif
 	, u8 key_index
@@ -1688,6 +1692,10 @@ static int cfg80211_rtw_add_key(struct wiphy *wiphy,
 	, const u8 *mac_addr, struct key_params *params)
 {
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 1, 0)
+        struct net_device *ndev = wdev->netdev;
+#endif
 	char *alg_name;
 	u32 param_len;
 	struct ieee_param *param = NULL;
-- 
