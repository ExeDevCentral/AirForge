#!/usr/bin/env bash
# ==============================================================================
# rtl8188eu-hotspot-toolkit: Advanced Hotspot & Driver Manager for Linux
# Author: Exequiel Echevarria <exemetal@hotmail.com> (ExeDevCentral)
# License: MIT
# ==============================================================================

set -eo pipefail

VERSION="1.0.0"
CON_NAME="Hotspot"
IFACE="wlan0"
SRC_DIR="${HOTSPOT_SRC_DIR:-$HOME/.local/share/rtl8188eus}"

# Color Palette (HUD modern minimalism)
RED="\033[1;31m"
GREEN="\033[1;32m"
BLUE="\033[1;34m"
YELLOW="\033[1;33m"
CYAN="\033[1;36m"
MAGENTA="\033[1;35m"
BOLD="\033[1m"
DIM="\033[2m"
RESET="\033[0m"

mostrar_banner() {
    echo -e "${CYAN}${BOLD}"
    cat << "EOF"
  ____ _____ _     ___  _  ___   ___  _____ _   _ 
 |  _ \_   _| |   / _ \/ |( _ ) ( _ )| ____| | | |
 | |_) || | | |  | (_) | |/ _ \ / _ \|  _| | | | |
 |  _ < | | | |___\__, | | (_) | (_) | |___| |_| |
 |_| \_\|_| |_____| /_/|_|\___/ \___/|_____|\___/ 
      HOTSPOT TOOLKIT & DRIVER MANAGER v1.0.0
EOF
    echo -e "${RESET}"
}

mostrar_ayuda() {
    mostrar_banner
    echo -e "${BOLD}Uso:${RESET} hotspot [comando] [opciones]"
    echo ""
    echo -e "${BOLD}${CYAN}Comandos principales:${RESET}"
    echo -e "  ${GREEN}status${RESET}              Muestra el estado completo del adaptador, radio y clientes"
    echo -e "  ${GREEN}on | start${RESET}          Enciende el punto de acceso Wi-Fi"
    echo -e "  ${GREEN}off | stop${RESET}          Apaga el punto de acceso Wi-Fi"
    echo -e "  ${GREEN}restart${RESET}             Reinicia la transmisión y los enrutamientos"
    echo -e "  ${GREEN}qr${RESET}                  Genera un código QR en consola para conectar celulares al instante"
    echo -e "  ${GREEN}clientes | clients${RESET}  Lista únicamente los dispositivos conectados en tiempo real"
    echo -e "  ${GREEN}traffic${RESET}             Muestra métricas de tráfico y bytes transmitidos/recibidos"
    echo -e "  ${GREEN}config [ssid] [pw]${RESET}  Modifica el nombre de red y la contraseña de seguridad"
    echo -e "  ${GREEN}rebuild${RESET}             Recompila e instala el driver si se actualiza el kernel"
    echo -e "  ${GREEN}service [accion]${RESET}    Gestiona el servicio systemd (enable, disable, status)"
    echo -e "  ${GREEN}version${RESET}             Muestra la versión de la suite"
    echo ""
    echo -e "${BOLD}${DIM}Repositorio: https://github.com/ExeDevCentral/rtl8188eu-hotspot-toolkit${RESET}"
}

cmd_status() {
    echo -e "${BOLD}${BLUE}╔══════════════════════════════════════════════════════════════════╗${RESET}"
    echo -e "${BOLD}${BLUE}║        ESTADO DEL PUNTO DE ACCESO WI-FI (RTL8188EUS)            ║${RESET}"
    echo -e "${BOLD}${BLUE}╚══════════════════════════════════════════════════════════════════╝${RESET}"
    
    # 1. Driver Kernel
    echo ""
    echo -e "${BOLD}${CYAN}[1/4] Controlador del Kernel:${RESET}"
    if lsmod | grep -q "^8188eu "; then
        echo -e "  Módulo: ${GREEN}● 8188eu cargado y activo${RESET} (Driver personalizado con AP mode)"
    elif lsmod | grep -q "rtl8xxxu"; then
        echo -e "  Módulo: ${YELLOW}▲ rtl8xxxu activo${RESET} (Driver genérico de fábrica, no soporta AP)"
    else
        echo -e "  Módulo: ${RED}✖ Ningún controlador Wi-Fi cargado${RESET}"
    fi

    # 2. Estado de la interfaz de red
    echo ""
    echo -e "${BOLD}${CYAN}[2/4] Estado de Interfaz Radio (${IFACE}):${RESET}"
    local oper ip_addr
    oper=$(cat /sys/class/net/"$IFACE"/operstate 2>/dev/null || echo "down")
    ip_addr=$(ip -4 addr show dev "$IFACE" 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -n1 || echo "Sin IP")

    if [ "$oper" = "up" ]; then
        echo -e "  Interfaz: ${BOLD}$IFACE${RESET} | Operstate: ${GREEN}UP (Transmitiendo)${RESET}"
        echo -e "  IP Gateway Local: ${BOLD}${GREEN}$ip_addr${RESET}"
    else
        echo -e "  Interfaz: ${BOLD}$IFACE${RESET} | Operstate: ${YELLOW}DOWN / INACTIVO${RESET}"
    fi

    # 3. Credenciales y configuración
    echo ""
    echo -e "${BOLD}${CYAN}[3/4] Parámetros de Transmisión:${RESET}"
    local ssid sec psk chan band
    ssid=$(nmcli -g 802-11-wireless.ssid connection show "$CON_NAME" 2>/dev/null || echo "Red-Exeq-WiFi")
    psk=$(nmcli -s -g 802-11-wireless-security.psk connection show "$CON_NAME" 2>/dev/null || echo "Central1985")
    chan=$(nmcli -g 802-11-wireless.channel connection show "$CON_NAME" 2>/dev/null || echo "6")
    band=$(nmcli -g 802-11-wireless.band connection show "$CON_NAME" 2>/dev/null || echo "bg")

    echo -e "  SSID (Nombre):    ${BOLD}${GREEN}${ssid}${RESET}"
    echo -e "  Contraseña:       ${YELLOW}${psk}${RESET}"
    echo -e "  Seguridad:        WPA2-PSK (AES/CCMP)"
    echo -e "  Banda / Canal:    2.4 GHz (${band}) — Canal ${chan} (2437 MHz)"

    # 4. Enrutamiento e IP Forwarding
    local ip_forward
    ip_forward=$(cat /proc/sys/net/ipv4/ip_forward 2>/dev/null || echo "0")
    if [ "$ip_forward" = "1" ]; then
        echo -e "  IP Forwarding:    ${GREEN}Habilitado (Ruteo NAT activo hacia Internet)${RESET}"
    else
        echo -e "  IP Forwarding:    ${RED}Deshabilitado (Solo red local, sin Internet)${RESET}"
    fi

    # Dispositivos conectados
    echo ""
    echo -e "${BOLD}${CYAN}[4/4] Dispositivos Conectados en este Momento:${RESET}"
    cmd_clientes
}

cmd_clientes() {
    local count=0

    while read -r ip _ _ mac _ dev; do
        if [ "$dev" = "$IFACE" ] && [ "$mac" != "00:00:00:00:00:00" ]; then
            count=$((count + 1))
            local host="Desconocido"
            if command -v getent &>/dev/null; then
                host=$(getent hosts "$ip" 2>/dev/null | awk '{print $2}' || echo "Dispositivo Wi-Fi")
            fi
            echo -e "  ${GREEN}●${RESET} Dispositivo #${count}: IP ${BOLD}${GREEN}$ip${RESET}  |  MAC: ${CYAN}$mac${RESET}  |  Host: $host"
        fi
    done < /proc/net/arp

    if [ "$count" -eq 0 ]; then
        echo -e "  ${YELLOW}(No hay clientes inalámbricos conectados)${RESET}"
    else
        echo -e "  ${BOLD}Total conectados:${RESET} ${GREEN}$count dispositivo(s)${RESET}"
    fi
}

cmd_qr() {
    local ssid psk
    ssid=$(nmcli -g 802-11-wireless.ssid connection show "$CON_NAME" 2>/dev/null || echo "Red-Exeq-WiFi")
    psk=$(nmcli -s -g 802-11-wireless-security.psk connection show "$CON_NAME" 2>/dev/null || echo "Central1985")

    echo -e "${BOLD}${CYAN}=== CÓDIGO QR PARA CONEXIÓN INSTANTÁNEA ===${RESET}"
    echo -e "Apuntá la cámara de tu celular para conectarte sin escribir la clave:"
    echo ""

    local qr_payload="WIFI:T:WPA;S:${ssid};P:${psk};;"
    if command -v qrencode &>/dev/null; then
        qrencode -t UTF8 "$qr_payload"
        echo ""
        echo -e "  ${BOLD}Red:${RESET} ${GREEN}$ssid${RESET}"
        echo -e "  ${BOLD}Clave:${RESET} ${YELLOW}$psk${RESET}"
    else
        echo -e "${YELLOW}Aviso: 'qrencode' no está instalado. Podés instalarlo con 'pacman -S qrencode' o 'apt install qrencode'.${RESET}"
        echo -e "Cadena de conexión estándar: ${BOLD}$qr_payload${RESET}"
    fi
}

cmd_on() {
    echo -e "${CYAN}Levantando punto de acceso Wi-Fi...${RESET}"
    if ! lsmod | grep -q "^8188eu "; then
        echo -e "${YELLOW}Cargando módulo 8188eu...${RESET}"
        pkexec modprobe 8188eu 2>/dev/null || sudo modprobe 8188eu
    fi
    nmcli connection up "$CON_NAME"
    echo -e "${GREEN}✓ Punto de acceso activo y transmitiendo.${RESET}"
}

cmd_off() {
    echo -e "${YELLOW}Deteniendo punto de acceso Wi-Fi...${RESET}"
    nmcli connection down "$CON_NAME" 2>/dev/null || true
    echo -e "${GREEN}✓ Punto de acceso apagado.${RESET}"
}

cmd_restart() {
    cmd_off
    sleep 1
    cmd_on
}

cmd_traffic() {
    echo -e "${BOLD}${CYAN}=== MÉTRICAS DE TRÁFICO (${IFACE}) ===${RESET}"
    if [ ! -f /proc/net/dev ]; then
        echo -e "${RED}No se pudo acceder a /proc/net/dev${RESET}"
        return 1
    fi

    local rx_bytes tx_bytes rx_pkts tx_pkts
    read -r rx_bytes rx_pkts _ _ _ _ _ _ tx_bytes tx_pkts _ < <(grep "^ *$IFACE:" /proc/net/dev | sed "s/^ *$IFACE://")

    if [ -z "$rx_bytes" ]; then
        echo -e "${YELLOW}La interfaz $IFACE no registra estadísticas activas.${RESET}"
        return 0
    fi

    local rx_mb tx_mb
    rx_mb=$(awk "BEGIN {printf \"%.2f\", $rx_bytes / 1048576}")
    tx_mb=$(awk "BEGIN {printf \"%.2f\", $tx_bytes / 1048576}")

    echo -e "  ${BOLD}Recibido (RX):${RESET}    ${GREEN}${rx_mb} MB${RESET} (${rx_pkts} paquetes)"
    echo -e "  ${BOLD}Transmitido (TX):${RESET} ${GREEN}${tx_mb} MB${RESET} (${tx_pkts} paquetes)"
}

cmd_config() {
    local nuevo_ssid="$1"
    local nuevo_psk="$2"
    local nuevo_canal="${3:-6}"

    if [ -z "$nuevo_ssid" ] || [ -z "$nuevo_psk" ]; then
        echo -e "${BOLD}Uso:${RESET} hotspot config [nuevo_ssid] [nueva_contraseña] [canal_opcional]"
        echo -e "Ejemplo: hotspot config MiWifiPro ClaveUltraSegura123 6"
        return 1
    fi

    echo -e "${CYAN}Actualizando configuración del Hotspot...${RESET}"
    nmcli connection modify "$CON_NAME" \
        802-11-wireless.ssid "$nuevo_ssid" \
        802-11-wireless.channel "$nuevo_canal" \
        802-11-wireless-security.psk "$nuevo_psk"

    echo -e "${GREEN}✓ Parámetros actualizados con éxito.${RESET}"
    echo -e "Reiniciando red para aplicar cambios..."
    cmd_restart
}

cmd_rebuild() {
    echo -e "${BOLD}${BLUE}=== RECOMPILACIÓN DEL MÓDULO 8188EU ===${RESET}"
    echo -e "Kernel objetivo: ${BOLD}$(uname -r)${RESET}"

    if [ ! -d "$SRC_DIR" ]; then
        # Verificar si estamos dentro del repositorio
        local repo_driver_dir
        repo_driver_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../driver" 2>/dev/null && pwd || true)"
        if [ -d "$repo_driver_dir" ]; then
            SRC_DIR="$repo_driver_dir"
        else
            echo -e "${RED}Error: Directorio de código fuente no encontrado en $SRC_DIR${RESET}"
            exit 1
        fi
    fi

    echo -e "Compilando en: ${CYAN}$SRC_DIR${RESET}..."
    cd "$SRC_DIR"
    make clean >/dev/null 2>&1 || true
    make -j"$(nproc)"

    if [ ! -f "8188eu.ko" ]; then
        echo -e "${RED}Error: La compilación no generó 8188eu.ko.${RESET}"
        exit 1
    fi

    strip --strip-unneeded 8188eu.ko
    echo -e "${GREEN}Módulo compilado y optimizado.${RESET}"

    local dest="/lib/modules/$(uname -r)/kernel/drivers/net/wireless/"
    echo -e "Instalando en ${dest}..."
    pkexec bash -c "mkdir -p '$dest' && install -p -m 644 8188eu.ko '$dest' && depmod -a && modprobe -r rtl8xxxu 2>/dev/null || true; modprobe 8188eu" || sudo bash -c "mkdir -p '$dest' && install -p -m 644 8188eu.ko '$dest' && depmod -a && modprobe -r rtl8xxxu 2>/dev/null || true; modprobe 8188eu"

    echo -e "${GREEN}✓ Driver 8188eu reinstalado y cargado correctamente en el kernel.${RESET}"
}

cmd_service() {
    local action="${1:-status}"
    case "$action" in
        enable)
            pkexec systemctl enable hotspot.service 2>/dev/null || sudo systemctl enable hotspot.service
            echo -e "${GREEN}✓ Servicio de Hotspot habilitado para inicio automático en el arranque.${RESET}"
            ;;
        disable)
            pkexec systemctl disable hotspot.service 2>/dev/null || sudo systemctl disable hotspot.service
            echo -e "${YELLOW}✓ Servicio de Hotspot deshabilitado del inicio automático.${RESET}"
            ;;
        start)
            pkexec systemctl start hotspot.service 2>/dev/null || sudo systemctl start hotspot.service
            ;;
        stop)
            pkexec systemctl stop hotspot.service 2>/dev/null || sudo systemctl stop hotspot.service
            ;;
        status)
            systemctl status hotspot.service --no-pager || true
            ;;
        *)
            echo -e "${RED}Acción de servicio no reconocida: $action${RESET}"
            echo -e "Opciones: enable | disable | start | stop | status"
            ;;
    esac
}

case "${1:-status}" in
    status)
        cmd_status
        ;;
    on|start)
        cmd_on
        ;;
    off|stop)
        cmd_off
        ;;
    restart)
        cmd_restart
        ;;
    clientes|clients)
        cmd_clientes
        ;;
    qr)
        cmd_qr
        ;;
    traffic)
        cmd_traffic
        ;;
    config)
        shift
        cmd_config "$@"
        ;;
    rebuild)
        cmd_rebuild
        ;;
    service)
        shift
        cmd_service "$@"
        ;;
    version|-v|--version)
        echo "rtl8188eu-hotspot-toolkit v${VERSION}"
        ;;
    help|-h|--help)
        mostrar_ayuda
        ;;
    *)
        echo -e "${RED}Opción no reconocida: $1${RESET}"
        mostrar_ayuda
        exit 1
        ;;
esac
